PORT=5000
NODE_ENV=development

# MongoDB 7.0 Replica Set (`rs0`) — Sole Authoritative CRM Database
MONGO_URI=mongodb://127.0.0.1:27017/admafia_crm?directConnection=true
MONGO_INITDB_DATABASE=admafia_crm

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_matching_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret_from_razorpay_dashboard
