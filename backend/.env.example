PORT=5000
NODE_ENV=development
TRUST_PROXY_HEADERS=true

# MongoDB 7.0 Replica Set (`rs0`) — Sole Authoritative CRM Database
MONGO_URI=mongodb://127.0.0.1:27017/admafia_crm?directConnection=true
MONGO_INITDB_DATABASE=admafia_crm
REDIS_URL=redis://127.0.0.1:6379

# Security & Session Signing (Generate 64-byte random hex secrets in production)
JWT_SECRET=replace_with_64_byte_random_hex_jwt_secret
OTP_HMAC_SECRET=replace_with_64_byte_random_hex_otp_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5051,https://admafia.marketing,https://www.admafia.marketing

# Meta WhatsApp Cloud API v26.0 (Universal Global User OTP Verification)
# Set OTP_MODE=live for real Meta WhatsApp Cloud API delivery, or OTP_MODE=sandbox for automated CI/E2E tests
OTP_MODE=live
WHATSAPP_ACCESS_TOKEN=replace_with_meta_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=1410175982181803
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=authentication
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token

# Firebase Cloud Messaging (FCM) Real-Time Push Notifications
# Run `node backend/scripts/setup-firebase.mjs` to provision from scratch
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloud-Ready Storage & Encrypted Backup Engine (`local` | `s3` for Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_CDN_URL=
BACKUP_DIR=/backups
BACKUP_PASSPHRASE=replace_with_strong_aes256_backup_passphrase
RCLONE_REMOTE=

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_matching_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret_from_razorpay_dashboard
